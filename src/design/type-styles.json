{
  "_note": "복합 타입 토큰(type styles) — 코드 소유. 한 토큰이 폰트·크기·행간·자간·케이스를 묶는다. (색은 일부러 제외: 사용처에서 text-ink/text-paper 로 붙인다.) font/size 는 Figma 토큰 이름을, leading/tracking 은 코드 스케일 이름을 참조. 빌드: `npm run tokens:build` → src/styles/type-styles.css 의 .type-* 클래스. 나중에 Figma Text Styles 내보내기로 이 파일을 채우면 디자이너 소유로 승급(B).",
  "_fields": "font: display|sans|mono · size: opening|hero|day|name|venue|kicker|quote|body|small|micro|label · leading: flush|cozy|verse|none|relaxed|loose|normal · tracking: tighter|tight|wide|wider|widest|ultra|editorial|normal · case: none|upper",

  "opening":   { "font": "display", "size": "opening", "leading": "flush",   "tracking": "tighter",   "case": "none" },
  "display":   { "font": "display", "size": "hero",    "leading": "flush",   "tracking": "tighter",   "case": "none" },
  "headline":  { "font": "display", "size": "day",     "leading": "none",    "tracking": "tighter",   "case": "none" },
  "title":     { "font": "display", "size": "name",    "leading": "none",    "tracking": "tight",     "case": "none" },
  "subtitle":  { "font": "display", "size": "venue",   "leading": "none",    "tracking": "tight",     "case": "none" },
  "kicker":    { "font": "display", "size": "kicker",  "leading": "none",    "tracking": "wider",     "case": "upper" },
  "quote":     { "font": "display", "size": "quote",   "leading": "cozy",    "tracking": "tight",     "case": "none" },

  "body":      { "font": "sans",    "size": "body",    "leading": "relaxed", "tracking": "normal",    "case": "none" },
  "verse":     { "font": "sans",    "size": "body",    "leading": "verse",   "tracking": "normal",    "case": "none" },
  "scripture": { "font": "sans",    "size": "small",   "leading": "loose",   "tracking": "normal",    "case": "none" },
  "caption":   { "font": "sans",    "size": "small",   "leading": "relaxed", "tracking": "normal",    "case": "none" },

  "overline":  { "font": "mono",    "size": "label",   "leading": "none",    "tracking": "editorial", "case": "upper" },
  "meta":      { "font": "mono",    "size": "micro",   "leading": "none",    "tracking": "editorial", "case": "none" },
  "data":      { "font": "mono",    "size": "small",   "leading": "normal",  "tracking": "wide",      "case": "none" }
}
