# 복사해서 .env.local 로 만들고 값 채우기:
#   cp .env.example .env.local
# .env.local 은 .gitignore 처리됨(커밋 안 됨).
# 주의: VITE_* 값은 브라우저 번들에 포함됩니다. Supabase anon key 및 청첩장 표시 정보처럼
# 공개되어도 되는 값만 넣으세요. 서비스 role key 같은 비밀키는 절대 넣지 마세요.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Couple
VITE_GROOM_NAME_KO=
VITE_GROOM_NAME_EN=
VITE_GROOM_FULL_NAME_EN=
VITE_GROOM_FATHER=
VITE_GROOM_MOTHER=
VITE_BRIDE_NAME_KO=
VITE_BRIDE_NAME_EN=
VITE_BRIDE_FULL_NAME_EN=
VITE_BRIDE_FATHER=
VITE_BRIDE_MOTHER=

# Wedding date / venue
VITE_WEDDING_DATE_ISO=2026-09-05T11:00
VITE_WEDDING_END_ISO=2026-09-05T13:00
VITE_WEDDING_DAY_KO=2026년 9월 5일 토요일 오전 11시
VITE_WEDDING_DAY_EN=Saturday, September 5, 2026
VITE_WEDDING_DATE_SHORT=2026.09.05
VITE_WEDDING_TIME=11:00 AM
VITE_VENUE_NAME=
VITE_VENUE_ADDRESS=
VITE_VENUE_TEL=
VITE_VENUE_LAT=37.541488
VITE_VENUE_LNG=126.997052
VITE_NAVER_MAP_URL=
VITE_KAKAO_MAP_URL=
VITE_GOOGLE_MAP_URL=

# Account — 총 2개만 사용
VITE_GROOM_BANK=
VITE_GROOM_ACCOUNT_NUMBER=
VITE_GROOM_ACCOUNT_HOLDER=
VITE_BRIDE_BANK=
VITE_BRIDE_ACCOUNT_NUMBER=
VITE_BRIDE_ACCOUNT_HOLDER=
