# 복사해서 .env.local 로 만들고 값 채우기:
#   cp .env.example .env.local
# .env.local 은 .gitignore 처리됨(커밋 안 됨).
#
# 청첩장에 표시되는 이름/날짜/장소/계좌/공유 문구는 src/config/wedding.js 에서 관리합니다.
# VITE_* 값은 브라우저 번들에 포함됩니다. service_role key 같은 비밀키는 절대 넣지 마세요.

# Supabase public client settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오톡 공유 (선택)
# https://developers.kakao.com 에서 앱 생성 → JavaScript 키 입력.
# 플랫폼 > Web 에 배포 도메인(예: https://teacherchae.github.io) 등록 필요.
# 비워두면 '카카오톡으로 공유하기' 버튼이 모바일 기본 공유 시트/링크 복사로 자동 폴백합니다.
VITE_KAKAO_JS_KEY=
